    - successfulDonations: successStatsRes[0]?.successCount // 0,
    - totalVisits: totalVisitsRes[0]?.value // 0,
    - verifiedBlood: donor.verifiedBlood,
    - sex: donor.sex,
    - blood: donor.blood,
    - last_donation_date: latestSuccessSq.last_date,
    - date: event_log.event_date,
    - eventName: event_log.name,
    - next_eligiblilty: donor.next_eligibility
    + or(ilike(event_log.name, '%$search%'): void
    + ilike(event_log.partner, '%$search%'): void
    + getFilteredEvents(filters: search?: string, status?: string, partner?: string, selectedCity?: string, sortBy?: string, =): void
    + getDonorMetrics(numericId: bigint): void
    + getEventById(numericId: bigint): void
    + getDonorBloodTypeBreakdown(eventWhereClause?: any): Promise[any[]]
    + getOverallAnalytics(filters: startDate?: string, endDate?: string, partner?: string, selectedCity?: string, sortBy?: string, =): void
    + countActiveDonors(eventWhereClause?: any): Promise[number]
    + ilike(city.name, '%$search%'): void
    + getEventAnalyticsData(eventIdStr: string): void
    + getLatestVisit(numericId: bigint): void
    + ilike(donor.first_name, '%$search%'): void
    + ilike(donor.last_name, '%$search%'): void
    + or(isNumeric ? eq(donor.id, BigInt(search.trim(): void
    + getDonorById(numericId: bigint): void
    + getFilteredDonors(filters: search?: string, bloodFilter?: string, sexFilter?: string, eligibilityFilter?: string, sortBy?: string, =): void
    + lte(donor.next_eligibility, nowStr): void
    + gt(donor.next_eligibility, nowStr): void
    + or(isNull(donor.next_eligibility): void
    + ilike(donor.email, '%$search%'): void
    + and(eq(donor.active, true): void
}

